# ==============================================================================
# DEVCONTROL AI - ORTAM DEĞİŞKENLERİ YAPILANDIRMASI
# ==============================================================================
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` dosyası .gitignore ve .dockerignore ile korunur; gizli değerler
# istemciye veya git geçmişine sızmaz.

# GEMINI_API_KEY: Google Gemini yapay zeka analizleri ve model zinciri için zorunludur.
GEMINI_API_KEY=""

# GITHUB_TOKEN: Canlı GitHub hesabınıza bağlanmak, tüm depoları, commit geçmişini
# ve dosya ağacını taramak için zorunludur (Personal Access Token - 'repo' yetkili).
GITHUB_TOKEN=""

# FIREBASE_PROJECT_ID: Firebase / GCP proje kimliği (Örn: your-project-id)
# Tanımlı değilse sırasıyla GOOGLE_CLOUD_PROJECT ve GCP_PROJECT okunur. Bu iki
# değişkeni Cloud Run otomatik sağladığı için orada ayrıca doldurmaya gerek
# yoktur; yerelde çalışırken en az biri tanımlı olmalıdır.
FIREBASE_PROJECT_ID=""

# FIRESTORE_DATABASE_ID: Hedef Firestore veritabanı adı veya ID'si (Örn: (default) veya ozel-db-adi)
FIRESTORE_DATABASE_ID=""

# TYPESAFE_API_KEY: TypeSafe AI System One (Jev) karar ve akıllı niyet
# yönlendiricisi için opsiyonel API anahtarı. Tanımlı değilse niyet yönlendirmesi
# ve kanıt doğrulaması atlanır; ajan yalnızca Gemini ile sentez üretir.
# Eski kurulumlarla uyumluluk için 'TYPESAFEAI' adı da kabul edilir.
TYPESAFE_API_KEY=""

# DEVCONTROL_API_TOKEN: Opsiyonel API erişim jetonu. Tanımlanırsa /api/*
# uç noktaları 'Authorization: Bearer <jeton>' veya 'X-Api-Token: <jeton>'
# başlığını zorunlu kılar. Boş bırakılırsa kapı devre dışıdır.
# Tarayıcı tarafı için jetonu localStorage'a yazın:
#   localStorage.setItem('devcontrol_api_token', '<jeton>')
DEVCONTROL_API_TOKEN=""

# PORT: Sunucunun dinleyeceği port (varsayılan: 3000; Cloud Run bunu kendisi atar).
PORT="3000"

# TRUST_PROXY_HOPS: `X-Forwarded-For` zincirinde sağdan güvenilecek proxy sayısı
# (varsayılan: 2 — Firebase Hosting + Cloud Run). Bu sayı gerçekte geçilen proxy
# sayısından büyük olursa istemci IP'si uydurulabilir hâle gelir ve hız sınırı
# (rate limit) atlatılabilir; bu yüzden kurulumla eşleşmelidir. Cloud Run URL'sine
# doğrudan (Hosting olmadan) erişiliyorsa 1 verin.
TRUST_PROXY_HOPS="2"

# NODE_ENV: BOŞ BIRAKIN. Sunucu, çalıştırılan modüle bakarak karar verir:
# `npm start` (dist/server.cjs) derlenmiş istemciyi, `npm run dev` (kaynak
# server.ts) Vite ara katmanını sunar. Buraya "development" yazmak bu ölçütün
# önüne geçer ve README'de "derlenmiş paketi çalıştırır" diye tanımlanan
# `npm start`'ı sessizce geliştirme moduna düşürürdü. Yalnızca konteynerde
# açıkça ayarlanır (bkz. Dockerfile: NODE_ENV=production).
# NODE_ENV=""

# DISABLE_HMR: 'true' değeri geliştirme sunucusunda HMR'ı ve dosya izlemeyi
# kapatır (aracı düzenlemelerinde CPU tasarrufu için). Yalnızca yerel geliştirmeyi
# etkiler; derlenmiş sunucu üzerinde etkisi yoktur.
DISABLE_HMR="false"
