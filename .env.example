# ==============================================================================
# DEVCONTROL AI - ORTAM DEĞİŞKENLERİ YAPILANDIRMASI
# ==============================================================================

# GEMINI_API_KEY: Google Gemini yapay zeka analizleri ve model zinciri için zorunludur.
GEMINI_API_KEY=""

# GITHUB_TOKEN: Canlı GitHub hesabınıza bağlanmak, tüm depoları, commit geçmişini
# ve dosya ağacını taramak için zorunludur (Personal Access Token - 'repo' yetkili).
GITHUB_TOKEN=""

# FIREBASE_PROJECT_ID: Firebase / GCP proje kimliği (Varsayılan: agenticai-500618)
FIREBASE_PROJECT_ID="agenticai-500618"

# FIRESTORE_DATABASE_ID: Hedef Firestore veritabanı adı veya ID'si (Örn: ai-studio-evekonomisivebte-5cc5a80b-6894-40e7-b870-cc7588f7630f veya (default))
FIRESTORE_DATABASE_ID="ai-studio-evekonomisivebte-5cc5a80b-6894-40e7-b870-cc7588f7630f"

