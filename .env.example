# ==============================================================================
# DEVCONTROL AI - ORTAM DEĞİŞKENLERİ YAPILANDIRMASI
# ==============================================================================

# GEMINI_API_KEY: Google Gemini yapay zeka analizleri ve model zinciri için zorunludur.
GEMINI_API_KEY=""

# GITHUB_TOKEN: Canlı GitHub hesabınıza bağlanmak, tüm depoları, commit geçmişini
# ve dosya ağacını taramak için zorunludur (Personal Access Token - 'repo' yetkili).
GITHUB_TOKEN=""

# FIREBASE_PROJECT_ID: Firebase / GCP proje kimliği (Örn: your-project-id)
FIREBASE_PROJECT_ID=""

# FIRESTORE_DATABASE_ID: Hedef Firestore veritabanı adı veya ID'si (Örn: (default) veya ozel-db-adi)
FIRESTORE_DATABASE_ID=""

